<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#111111">
          Welcome to DolphStore, {{firstName}}!
        </mj-text>
        <mj-text font-size="14px" color="#444444" line-height="22px">
          Your account has been created. You can now browse listings, save favorites, and message agents directly from your dashboard.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
