<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#111111">
          Verify your email, {{firstName}}
        </mj-text>
        <mj-text font-size="14px" color="#444444" line-height="22px">
          Use the code below to verify your DolphStore account. It expires in 15 minutes.
        </mj-text>
        <mj-text font-size="32px" font-weight="700" letter-spacing="6px" align="center" color="#111111">
          {{code}}
        </mj-text>
        <mj-text font-size="12px" color="#888888">
          If you didn't create a DolphStore account, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
