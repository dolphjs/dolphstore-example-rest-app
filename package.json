{
  "author": "",
  "description": "DolphStore — a real estate REST API built with DolphJS, TypeORM, and PostgreSQL.",
  "dependencies": {
    "@dolphjs/dolph": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.9.2",
    "ms": "^2.1.3",
    "pg": "^8.11.3",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@dolphjs/testing": "^1.0.0",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.91",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.8.2",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^12.4.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "main": "app/server.js",
  "name": "dolphstore",
  "scripts": {
    "build": "dolph build",
    "build:tsc": "tsc && tsc-alias",
    "clean": "rm -r app && rm -r logs",
    "dev:docker:start": "docker-compose -f docker-compose-dev.yml up",
    "dev:docker:stop": "docker-compose -f docker-compose-dev.yml down",
    "dev:start": "dolph watch",
    "start": "dolph start",
    "test": "jest",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
  },
  "version": "0.1.0"
}
