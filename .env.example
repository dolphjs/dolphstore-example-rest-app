# Copy to .env and fill in real values. See src/shared/configs/env.schema.ts
# for the full validation rules — the app refuses to boot if any required
# variable here is missing or malformed.

NODE_ENV=development
PORT=3300
APP_NAME=DolphStore
CORS_ORIGIN=*

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Also keep `database.typeorm.options.port`/`database` in dolph_config.yaml
# in sync with SQL_PORT/SQL_DATABASE below if you change them — see the
# comment in that file for why.
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DATABASE=dolphstore

# Optional until the payments module is built.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
