{
  "openapi": "3.0.3",
  "info": {
    "title": "DolphStore API",
    "description": "Real estate REST API built with DolphJS, TypeORM, and PostgreSQL.",
    "version": "0.1.0",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "http://localhost:3300/v1", "description": "Local development" }
  ],
  "tags": [
    { "name": "Auth", "description": "Registration, login, and session management" },
    { "name": "Properties", "description": "Property listings and their images" }
  ],
  "paths": {
    "/properties": {
      "get": {
        "tags": ["Properties"],
        "summary": "Search published property listings",
        "operationId": "searchProperties",
        "security": [],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/LimitParam" },
          { "$ref": "#/components/parameters/OrderParam" },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "state", "in": "query", "schema": { "type": "string" } },
          { "name": "listingType", "in": "query", "schema": { "type": "string", "enum": ["sale", "rent"] } },
          { "name": "propertyType", "in": "query", "schema": { "type": "string", "enum": ["apartment", "house", "land", "commercial"] } },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "minBedrooms", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated published listings",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaginatedProperties" } } }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "post": {
        "tags": ["Properties"],
        "summary": "Create a property listing (starts as draft)",
        "operationId": "createProperty",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePropertyDto" } } }
        },
        "responses": {
          "200": {
            "description": "Property created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Property" } } }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": {
            "description": "Authenticated, but not an agent or admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/properties/mine": {
      "get": {
        "tags": ["Properties"],
        "summary": "List the current agent's own listings, at any status",
        "operationId": "myProperties",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/LimitParam" },
          { "$ref": "#/components/parameters/OrderParam" },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "state", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated listings owned by the caller",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaginatedProperties" } } }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": {
            "description": "Authenticated, but not an agent or admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/properties/{id}": {
      "get": {
        "tags": ["Properties"],
        "summary": "Get a single published property",
        "operationId": "getProperty",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/PropertyIdPathParam" }],
        "responses": {
          "200": {
            "description": "The property",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Property" } } }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found (includes drafts/archived — this route only ever returns published listings)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      },
      "patch": {
        "tags": ["Properties"],
        "summary": "Update a property (owning agent or admin only)",
        "operationId": "updateProperty",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PropertyIdPathParam" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePropertyDto" } } }
        },
        "responses": {
          "200": {
            "description": "Updated property",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Property" } } }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": {
            "description": "Not the owning agent and not an admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Properties"],
        "summary": "Soft-delete a property (owning agent or admin only)",
        "operationId": "deleteProperty",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PropertyIdPathParam" }],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/MessageResult" } } }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": {
            "description": "Not the owning agent and not an admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/properties/{id}/images": {
      "post": {
        "tags": ["Properties"],
        "summary": "Upload a property image (owning agent or admin only)",
        "operationId": "uploadPropertyImage",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PropertyIdPathParam" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": { "image": { "type": "string", "format": "binary" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PropertyImage" } } }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": {
            "description": "Not the owning agent and not an admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/properties/{id}/images/{imageId}": {
      "delete": {
        "tags": ["Properties"],
        "summary": "Remove a property image (owning agent or admin only)",
        "operationId": "removePropertyImage",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/PropertyIdPathParam" },
          { "name": "imageId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/MessageResult" } } }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": {
            "description": "Not the owning agent and not an admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered — a 6-digit verification code was emailed; login is blocked until it's confirmed via /auth/verify-email",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/RegisterResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Confirm a registration with the 6-digit code emailed to the user",
        "operationId": "verifyEmail",
        "security": [],
        "description": "On success, the account is marked verified and a token pair is issued immediately — no separate login call is needed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyEmailDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/AuthResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": {
            "description": "Invalid, expired, or already-used code",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "409": {
            "description": "Email already verified",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": ["Auth"],
        "summary": "Resend the email verification code",
        "operationId": "resendVerification",
        "security": [],
        "description": "Always returns 200 with the same generic message, regardless of whether the account exists, is already verified, or is within the 60-second resend cooldown — this prevents the endpoint from being used to enumerate registered emails.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResendVerificationDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/MessageResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email and password",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/AuthResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": {
            "description": "Invalid email or password",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "403": {
            "description": "Credentials are correct, but the email hasn't been verified yet",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange a refresh token for a new access/refresh token pair",
        "operationId": "refreshToken",
        "security": [],
        "description": "Refresh tokens are single-use — the token supplied here is revoked whether or not the exchange succeeds.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New token pair",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/TokenPair" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke a single refresh token (log out this device)",
        "operationId": "logout",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/MessageResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/logout-all": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke every refresh token issued to the current user (log out everywhere)",
        "operationId": "logoutAll",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logged out of all devices",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/MessageResult" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get the current authenticated user's profile",
        "operationId": "getCurrentUser",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/User" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "PageParam": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "LimitParam": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "OrderParam": { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"], "default": "DESC" } },
      "PropertyIdPathParam": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "ValidationError": {
        "description": "DTO validation failed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "status": { "type": "integer", "example": 200 },
          "message": { "type": "string", "example": "Request successful" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 401 },
          "message": { "type": "string", "example": "invalid email or password" }
        }
      },
      "ValidationErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 400 },
          "message": { "type": "string", "example": "Validation failed for request body" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "example": "email" },
                "messages": {
                  "type": "array",
                  "items": { "type": "string" },
                  "example": ["email must be an email"]
                }
              }
            }
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "required": ["email", "password", "firstName", "lastName", "phone"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Must contain at least one letter and one number."
          },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "phone": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["user", "agent"],
            "description": "Defaults to \"user\". \"admin\" cannot be self-assigned."
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "RefreshTokenDto": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "VerifyEmailDto": {
        "type": "object",
        "required": ["email", "code"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "code": { "type": "string", "pattern": "^\\d{6}$", "example": "482913" }
        }
      },
      "ResendVerificationDto": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "phone": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "agent", "user"] },
          "emailVerifiedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "MessageResult": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "RegisterResult": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "CreatePropertyDto": {
        "type": "object",
        "required": ["title", "description", "price", "listingType", "propertyType", "address", "city", "state"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string", "default": "NGN" },
          "listingType": { "type": "string", "enum": ["sale", "rent"] },
          "propertyType": { "type": "string", "enum": ["apartment", "house", "land", "commercial"] },
          "bedrooms": { "type": "integer", "default": 0 },
          "bathrooms": { "type": "integer", "default": 0 },
          "areaSqm": { "type": "number", "nullable": true },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "country": { "type": "string", "default": "Nigeria" }
        }
      },
